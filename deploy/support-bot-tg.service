[Unit]
Description=Telegram support bot (DialogFlow)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/support-bot
EnvironmentFile=/opt/support-bot/.env
ExecStart=/opt/support-bot/.venv/bin/python tg_bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target